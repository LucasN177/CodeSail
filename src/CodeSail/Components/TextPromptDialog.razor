@* Einfacher Dialog mit einem Eingabefeld, z. B. für Dateipfade und Branch-Namen. *@

<MudDialog>
    <DialogContent>
        <form id="text-prompt-form" @onsubmit="Submit">
            @if (Message is not null)
            {
                <MudText Typo="Typo.body2" Class="mb-3">@Message</MudText>
            }
            <MudTextField @bind-Value="_value" Label="@Label" Variant="Variant.Outlined" Immediate="true" AutoFocus="true"
                          spellcheck="false" autocapitalize="off" autocomplete="off" />
        </form>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Abbrechen</MudButton>
        <MudButton ButtonType="ButtonType.Submit" form="text-prompt-form" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="string.IsNullOrWhiteSpace(_value)">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private string _value = "";

    [CascadingParameter] public IMudDialogInstance Dialog { get; set; } = default!;

    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Message { get; set; }
    [Parameter] public string InitialValue { get; set; } = "";
    [Parameter] public string ConfirmText { get; set; } = "OK";

    protected override void OnInitialized() => _value = InitialValue;

    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(_value))
            Dialog.Close(DialogResult.Ok(_value.Trim()));
    }

    /// <summary>Zeigt den Dialog und liefert die Eingabe oder null bei Abbruch.</summary>
    public static async Task<string?> ShowAsync(IDialogService dialogs, string title, string label,
        string initialValue = "", string confirmText = "OK", string? message = null)
    {
        var parameters = new DialogParameters<TextPromptDialog>
        {
            { x => x.Label, label },
            { x => x.InitialValue, initialValue },
            { x => x.ConfirmText, confirmText },
            { x => x.Message, message }
        };
        var dialog = await dialogs.ShowAsync<TextPromptDialog>(title, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        return result is { Canceled: false, Data: string value } ? value : null;
    }
}
