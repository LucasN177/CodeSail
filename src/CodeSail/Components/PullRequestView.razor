@* Detailansicht eines Pull Requests im Hauptbereich: Beschreibung, Dateien mit Diff, Mergen/Schließen. *@
@inject PullRequestService PullRequests
@inject MergeService Merges
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<div class="pr-view">
    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error" Class="ma-4">
            @_error
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick="LoadAsync">Erneut versuchen</MudButton>
        </MudAlert>
    }
    else if (_details is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        var pr = _details.Summary;
        <header class="pr-header">
            <div class="d-flex align-center gap-2 flex-wrap">
                <span class="pr-state" style="@($"background: {PullRequestsPanel.StateColor(pr)}")">
                    <MudIcon Icon="@PullRequestsPanel.StateIcon(pr)" Size="Size.Small" /> @PullRequestsPanel.StateLabel(pr)
                </span>
                <MudText Typo="Typo.h6" Class="pr-heading">@pr.Title <span class="mud-text-secondary">#@pr.Number</span></MudText>
                <MudTooltip Text="Titel und Beschreibung bearbeiten">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Disabled="@(_busy || !Online)"
                                   OnClick="EditAsync" aria-label="Titel und Beschreibung bearbeiten" />
                </MudTooltip>
            </div>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                <b>@pr.Author</b> möchte <code>@pr.Head</code> in <code>@pr.Base</code> übernehmen ·
                @_details.Commits @(_details.Commits == 1 ? "Commit" : "Commits") ·
                <span class="pr-add">+@_details.Additions</span> <span class="pr-del">−@_details.Deletions</span> ·
                @_details.ChangedFiles @(_details.ChangedFiles == 1 ? "Datei" : "Dateien")
            </MudText>

            <div class="d-flex align-center gap-2 flex-wrap mt-3">
                @if (pr.State == PullRequestState.Open)
                {
                    <MudTooltip Text="@MergeHint">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CallMerge"
                                   Disabled="@(!_details.CanMerge || _busy || !Online)" OnClick="MergeAsync">Mergen</MudButton>
                    </MudTooltip>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Block"
                               Disabled="@(_busy || !Online)" OnClick="() => SetOpenAsync(false)">Schließen</MudButton>
                }
                else if (pr.State == PullRequestState.Closed)
                {
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Replay"
                               Disabled="@(_busy || !Online)" OnClick="() => SetOpenAsync(true)">Wieder öffnen</MudButton>
                }
                @if (pr.State == PullRequestState.Open && _details.MergeableState == "behind" && PullRequestService.IsSameRepository(Owner, Repo, pr))
                {
                    <MudTooltip Text="@($"Neue Commits von {pr.Base} in {pr.Head} übernehmen")">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Sync"
                                   Disabled="@(_busy || !Online)" OnClick="UpdateBranchAsync">Branch aktualisieren</MudButton>
                    </MudTooltip>
                }
                @if (CanOpenBranch)
                {
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.AccountTree"
                               OnClick="() => OpenBranch.InvokeAsync(pr.Head)">Branch @pr.Head öffnen</MudButton>
                }
                <MudButton Variant="Variant.Text" StartIcon="@Icons.Custom.Brands.GitHub" Href="@pr.HtmlUrl" Target="_blank">Auf GitHub</MudButton>
            </div>
            @if (pr.State == PullRequestState.Open && MergeProblem is { } problem)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@problem</MudAlert>
            }

            @if (_ci is { } ci)
            {
                <div class="pr-ci mt-3">
                    @if (ci.Overall is { } overall)
                    {
                        <div class="pr-ci-summary" @onclick="() => _ciOpen = !_ciOpen" role="button" aria-expanded="@_ciOpen">
                            <MudIcon Icon="@CheckIcon(overall)" Size="Size.Small" Style="@($"color: {CheckColor(overall)}")" />
                            <span>@CheckSummary(ci)</span>
                            <MudIcon Icon="@(_ciOpen ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                        </div>
                        @if (_ciOpen)
                        {
                            @foreach (var check in ci.Items)
                            {
                                <div class="pr-ci-item">
                                    <MudIcon Icon="@CheckIcon(check.State)" Size="Size.Small" Style="@($"color: {CheckColor(check.State)}")" />
                                    <span class="pr-ci-name">@check.Name</span>
                                    <span class="mud-text-secondary pr-ci-desc">@check.Description</span>
                                    @if (check.Url is { } url)
                                    {
                                        <MudLink Href="@url" Target="_blank" Typo="Typo.caption">Details</MudLink>
                                    }
                                </div>
                            }
                        }
                    }
                    else if (!ci.MissingPermission)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Keine CI-Checks für diesen Stand.</MudText>
                    }
                    @if (ci.MissingPermission)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                            CI-Status unvollständig: Das Token braucht dafür die Leserechte „Commit statuses“ und „Checks“.
                        </MudText>
                    }
                </div>
            }
        </header>

        <section class="pr-section">
            @if (string.IsNullOrWhiteSpace(_details.Body))
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Keine Beschreibung.</MudText>
            }
            else
            {
                <MarkdownFrame Markdown="@_details.Body" Title="@($"Beschreibung von #{pr.Number}")" />
            }
        </section>

        <section class="pr-section">
            <MudText Typo="Typo.subtitle1" Class="mb-1">Geänderte Dateien</MudText>
            @if (_files is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <FileDiffList Files="_files" Total="_details.ChangedFiles" />
            }
        </section>

        <section class="pr-section">
            <MudText Typo="Typo.subtitle1" Class="mb-2">Unterhaltung</MudText>
            @if (_conversation is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (_conversation.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">Noch keine Kommentare oder Reviews.</MudText>
            }
            else
            {
                @foreach (var item in _conversation)
                {
                    <div class="pr-comment">
                        <div class="pr-comment-head">
                            <b>@item.Author</b>
                            @if (item.Kind == ConversationKind.Review)
                            {
                                <span class="pr-review-badge review-@item.ReviewState?.ToLowerInvariant()">@ReviewLabel(item.ReviewState)</span>
                            }
                            @if (item.Kind == ConversationKind.LineComment)
                            {
                                <code class="pr-comment-path">@item.Path@(item.Line is { } l ? $":{l}" : "")</code>
                            }
                            <span class="mud-text-secondary">@(item.Date > DateTimeOffset.MinValue ? TimeFormat.Relative(item.Date, DateTimeOffset.UtcNow) : "")</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Body))
                        {
                            @* Bewusst als reiner Text: Kommentare stammen von Dritten und werden nicht als HTML gerendert *@
                            <div class="pr-comment-body">@item.Body</div>
                        }
                    </div>
                }
            }

            @if (pr.State != PullRequestState.Merged)
            {
                <MudTextField @bind-Value="_reply" Label="Kommentar oder Review (Markdown)" Variant="Variant.Outlined" Lines="4"
                              Immediate="true" Disabled="@(_busy || !Online)" Class="mt-2" />
                <div class="d-flex flex-wrap gap-2 mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Comment"
                               Disabled="@(_busy || !Online || string.IsNullOrWhiteSpace(_reply))"
                               OnClick="CommentAsync">Kommentieren</MudButton>
                    @if (pr.State == PullRequestState.Open)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check"
                                   Disabled="@(_busy || !Online)" OnClick="() => ReviewAsync(ReviewAction.Approve)">Genehmigen</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.RateReview"
                                   Disabled="@(_busy || !Online || string.IsNullOrWhiteSpace(_reply))"
                                   OnClick="() => ReviewAsync(ReviewAction.RequestChanges)">Änderungen anfordern</MudButton>
                    }
                </div>
            }
        </section>
    }
</div>

@code {
    private PullRequestDetails? _details;
    private IReadOnlyList<PullRequestFile>? _files;
    private IReadOnlyList<ConversationItem>? _conversation;
    private CiStatus? _ci;
    private bool _ciOpen;
    private string _reply = "";
    private string? _error;
    private bool _busy;
    private (string, string, int)? _loaded;

    [Parameter, EditorRequired] public string Owner { get; set; } = "";
    [Parameter, EditorRequired] public string Repo { get; set; } = "";
    [Parameter, EditorRequired] public int Number { get; set; }
    [Parameter] public IReadOnlyCollection<string> BranchNames { get; set; } = [];
    [Parameter] public string DefaultBranch { get; set; } = "";
    [Parameter] public bool Online { get; set; } = true;

    [Parameter] public EventCallback<string> OpenBranch { get; set; }

    /// <summary>Nach Mergen, Schließen oder Wiederöffnen; true, wenn dabei ein Branch gelöscht wurde.</summary>
    [Parameter] public EventCallback<bool> Changed { get; set; }

    private bool CanOpenBranch => _details is { } d
        && PullRequestService.IsSameRepository(Owner, Repo, d.Summary)
        && BranchNames.Contains(d.Summary.Head);

    private string? MergeProblem => _details switch
    {
        { Summary.Draft: true } => "Entwurf: Markiere den Pull Request auf GitHub als bereit, um ihn zu mergen.",
        { Mergeable: false } => "Es gibt Konflikte mit dem Ziel-Branch. Löse sie im Branch oder auf GitHub.",
        { Mergeable: null } => "GitHub prüft noch, ob sich der Pull Request mergen lässt. Lade die Ansicht gleich neu.",
        _ => null
    };

    private string MergeHint => MergeProblem ?? "Pull Request mergen";

    protected override async Task OnParametersSetAsync()
    {
        if (_loaded != (Owner, Repo, Number))
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loaded = (Owner, Repo, Number);
        _details = null;
        _files = null;
        _conversation = null;
        _ci = null;
        _error = null;
        try
        {
            _details = await PullRequests.GetAsync(Owner, Repo, Number);
            StateHasChanged();
            _files = await PullRequests.GetFilesAsync(Owner, Repo, Number);
            StateHasChanged();
            _ci = await PullRequests.GetCiStatusAsync(Owner, Repo, _details.HeadSha);
            _conversation = await PullRequests.GetConversationAsync(Owner, Repo, Number);
        }
        catch (Exception ex)
        {
            _error = GitHubErrors.Describe(ex);
        }
    }

    private async Task MergeAsync()
    {
        if (_details is null)
            return;

        var canDelete = PullRequestService.IsSameRepository(Owner, Repo, _details.Summary) && _details.Summary.Head != DefaultBranch;
        var dialog = await Dialogs.ShowAsync<MergeDialog>($"#{_details.Summary.Number} mergen",
            new DialogParameters<MergeDialog> { { x => x.PullRequest, _details }, { x => x.CanDeleteBranch, canDelete } },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: ValueTuple<MergeMethod, bool> choice })
            return;

        _busy = true;
        try
        {
            var deleted = await PullRequests.MergeAsync(Owner, Repo, _details, choice.Item1, choice.Item2);
            Snackbar.Add(deleted ? $"Gemergt, Branch {_details.Summary.Head} gelöscht." : "Pull Request gemergt.", Severity.Success);
            await LoadAsync();
            await Changed.InvokeAsync(deleted);
        }
        catch (GitHubApiException ex) when (ex.Status == System.Net.HttpStatusCode.Conflict)
        {
            Snackbar.Add("Der Branch hat sich inzwischen geändert. Die Ansicht wird neu geladen, bitte prüfe und merge erneut.", Severity.Warning);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(GitHubErrors.Describe(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EditAsync()
    {
        if (_details is null)
            return;
        var dialog = await Dialogs.ShowAsync<EditPullRequestDialog>($"#{Number} bearbeiten",
            new DialogParameters<EditPullRequestDialog> { { x => x.Title, _details.Summary.Title }, { x => x.Body, _details.Body } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is not { Canceled: false, Data: ValueTuple<string, string> edited })
            return;

        await RunAsync(async () =>
        {
            await PullRequests.UpdateAsync(Owner, Repo, Number, edited.Item1, edited.Item2);
            Snackbar.Add("Pull Request aktualisiert.", Severity.Success);
            await LoadAsync();
            await Changed.InvokeAsync(false);
        });
    }

    private Task CommentAsync() => RunAsync(async () =>
    {
        await PullRequests.CommentAsync(Owner, Repo, Number, _reply);
        _reply = "";
        _conversation = await PullRequests.GetConversationAsync(Owner, Repo, Number);
    });

    private Task ReviewAsync(ReviewAction action) => RunAsync(async () =>
    {
        await PullRequests.ReviewAsync(Owner, Repo, Number, action, _reply);
        _reply = "";
        Snackbar.Add(action == ReviewAction.Approve ? "Pull Request genehmigt." : "Änderungen angefordert.", Severity.Success);
        _conversation = await PullRequests.GetConversationAsync(Owner, Repo, Number);
    });

    /// <summary>Führt eine Aktion mit Sperre der Buttons aus und zeigt Fehler als Hinweis an.</summary>
    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        try
        {
            await action();
        }
        catch (Exception ex)
        {
            Snackbar.Add(GitHubErrors.Describe(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ReviewLabel(string? state) => state switch
    {
        "APPROVED" => "hat genehmigt",
        "CHANGES_REQUESTED" => "möchte Änderungen",
        "DISMISSED" => "Review verworfen",
        _ => "Review"
    };

    private static string CheckIcon(CheckState state) => state switch
    {
        CheckState.Success => Icons.Material.Filled.CheckCircle,
        CheckState.Pending => Icons.Material.Filled.Pending,
        CheckState.Failure => Icons.Material.Filled.Cancel,
        _ => Icons.Material.Filled.RemoveCircleOutline
    };

    private static string CheckColor(CheckState state) => state switch
    {
        CheckState.Success => "#3fb950",
        CheckState.Pending => "#d29922",
        CheckState.Failure => "#f85149",
        _ => "#8b949e"
    };

    private static string CheckSummary(CiStatus ci)
    {
        var failed = ci.Items.Count(i => i.State == CheckState.Failure);
        var pending = ci.Items.Count(i => i.State == CheckState.Pending);
        return ci.Overall switch
        {
            CheckState.Failure => $"{failed} von {ci.Items.Count} Checks fehlgeschlagen",
            CheckState.Pending => $"{pending} von {ci.Items.Count} Checks laufen noch",
            _ => $"Alle {ci.Items.Count} Checks erfolgreich"
        };
    }

    private async Task UpdateBranchAsync()
    {
        if (_details is null)
            return;

        _busy = true;
        try
        {
            var result = await Merges.UpdateBranchAsync(Owner, Repo, _details.Summary.Head, _details.Summary.Base);
            Snackbar.Add(result switch
            {
                BranchUpdateResult.Updated => $"{_details.Summary.Head} ist jetzt auf dem Stand von {_details.Summary.Base}.",
                BranchUpdateResult.UpToDate => "Der Branch ist bereits aktuell.",
                _ => "Überschneidende Änderungen: Bitte auf GitHub unter „Resolve conflicts“ lösen."
            }, result == BranchUpdateResult.Conflict ? Severity.Warning : Severity.Success);
            await LoadAsync();
            await Changed.InvokeAsync(false);
        }
        catch (Exception ex)
        {
            Snackbar.Add(GitHubErrors.Describe(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SetOpenAsync(bool open)
    {
        if (_details is null)
            return;

        _busy = true;
        try
        {
            await PullRequests.SetOpenAsync(Owner, Repo, Number, open);
            Snackbar.Add(open ? "Pull Request wieder geöffnet." : "Pull Request geschlossen.", Severity.Success);
            await LoadAsync();
            await Changed.InvokeAsync(false);
        }
        catch (Exception ex)
        {
            Snackbar.Add(GitHubErrors.Describe(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

}
