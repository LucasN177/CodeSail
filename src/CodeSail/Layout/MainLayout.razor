@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject IGitHubService GitHub
@inject NavigationManager Nav

<MudThemeProvider IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudLink Href="@(Auth.IsAuthenticated ? "repos" : "")" Color="Color.Inherit" Underline="Underline.None">
            <MudText Typo="Typo.h6">⚓️ CodeSail</MudText>
        </MudLink>
        <MudSpacer />
        @if (Auth.IsAuthenticated)
        {
            @if (GitHub.RateLimit is { } rate)
            {
                <MudTooltip Text="@($"Verbleibende GitHub-API-Anfragen, zurückgesetzt um {rate.ResetAt.ToLocalTime():HH:mm} Uhr")">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(rate.Remaining < 100 ? Color.Warning : Color.Default)">
                        API @rate.Remaining / @rate.Limit
                    </MudChip>
                </MudTooltip>
            }
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Konto">
                <MudMenuItem Icon="@Icons.Custom.Brands.GitHub" Disabled="true">@Auth.Login</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">Abmelden</MudMenuItem>
            </MudMenu>
        }
    </MudAppBar>

    <MudMainContent>
        @if (!Auth.IsInitialized || (!Auth.IsAuthenticated && !IsPublicPage()))
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            @Body
        }
    </MudMainContent>
</MudLayout>

@code {
    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnStateChanged;
        GitHub.RateLimitChanged += OnStateChanged;
        await Auth.InitializeAsync();
    }

    protected override void OnParametersSet()
    {
        // Alle Seiten außer Login und "Nicht gefunden" erfordern eine Anmeldung
        if (Auth.IsInitialized && !Auth.IsAuthenticated && !IsPublicPage())
            Nav.NavigateTo("", replace: true);
    }

    private bool IsPublicPage()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        return path is "" or "not-found";
    }

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("", replace: true);
    }

    private void OnStateChanged()
    {
        InvokeAsync(() =>
        {
            OnParametersSet();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Auth.Changed -= OnStateChanged;
        GitHub.RateLimitChanged -= OnStateChanged;
    }
}
