@inherits LayoutComponentBase
@implements IDisposable
@inject AuthState Auth
@inject IGitHubService GitHub
@inject BrowserEnvironment Browser
@inject WorkspaceService Workspace
@inject IFileCache Cache
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject SettingsService Settings

<MudThemeProvider IsDarkMode="Settings.IsDark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true">
        <MudLink Href="@(Auth.IsAuthenticated ? "repos" : "")" Color="Color.Inherit" Underline="Underline.None"
                 Class="d-flex align-center">
            <img src="icon.svg" alt="" width="26" height="26" class="mr-2" style="border-radius: 6px" />
            <MudText Typo="Typo.h6">CodeSail</MudText>
        </MudLink>
        <MudSpacer />
        @if (Browser.UpdateAvailable)
        {
            <MudTooltip Text="Eine neue Version von CodeSail ist geladen">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mr-2"
                           StartIcon="@Icons.Material.Filled.SystemUpdate" OnClick="ApplyUpdateAsync">Aktualisieren</MudButton>
            </MudTooltip>
        }
        @if (!Browser.IsOnline)
        {
            <MudTooltip Text="Keine Verbindung. Änderungen werden lokal gespeichert.">
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Icon="@Icons.Material.Filled.CloudOff">Offline</MudChip>
            </MudTooltip>
        }
        @if (Auth.IsAuthenticated)
        {
            @if (GitHub.RateLimit is { } rate)
            {
                <MudTooltip Text="@($"Verbleibende GitHub-API-Anfragen, zurückgesetzt um {rate.ResetAt.ToLocalTime():HH:mm} Uhr")">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                             Color="@(rate.Remaining < 100 ? Color.Warning : Color.Default)">
                        API @rate.Remaining / @rate.Limit
                    </MudChip>
                </MudTooltip>
            }
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" OpenChanged="OnMenuOpenChanged"
                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" aria-label="Konto">
                <MudMenuItem Icon="@Icons.Custom.Brands.GitHub" Disabled="true">@Auth.Login</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Storage" Disabled="true">Offline-Speicher: @FormatUsage()</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Settings" OnClick="OpenSettingsAsync">Einstellungen</MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Logout" OnClick="LogoutAsync">Abmelden</MudMenuItem>
            </MudMenu>
        }
    </MudAppBar>

    <MudMainContent>
        @if (!Auth.IsInitialized || (!Auth.IsAuthenticated && !IsPublicPage()))
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        }
        else
        {
            @Body
        }
    </MudMainContent>
</MudLayout>

@code {
    private long? _usage;

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += OnStateChanged;
        GitHub.RateLimitChanged += OnStateChanged;
        Browser.ConnectivityChanged += OnStateChanged;
        Browser.UpdateReady += OnStateChanged;
        Settings.Changed += OnStateChanged;

        await Browser.InitializeAsync();
        await Settings.LoadAsync(Browser.PrefersDark);
        await Auth.InitializeAsync();

        // Ohne diese Bitte darf Safari den Offline-Cache nach einigen Tagen ohne Nutzung löschen
        _ = Cache.RequestPersistenceAsync();
    }

    protected override void OnParametersSet()
    {
        // Alle Seiten außer Login und "Nicht gefunden" erfordern eine Anmeldung.
        // Die aktuelle Seite wird gemerkt, damit es nach dem (erneuten) Anmelden dort weitergeht.
        if (Auth.IsInitialized && !Auth.IsAuthenticated && !IsPublicPage())
        {
            Auth.ReturnUrl = Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo("", replace: true);
        }
    }

    private bool IsPublicPage()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0];
        return path is "" or "not-found";
    }

    private async Task OnMenuOpenChanged(bool open)
    {
        if (open)
            _usage = await Cache.EstimateUsageAsync();
    }

    private string FormatUsage() => _usage switch
    {
        null => "unbekannt",
        < 1024 * 1024 => $"{_usage / 1024.0:0.#} KB",
        _ => $"{_usage / (1024.0 * 1024):0.#} MB"
    };

    private Task OpenSettingsAsync() =>
        Dialogs.ShowAsync<SettingsDialog>("Einstellungen", new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });

    private async Task ApplyUpdateAsync()
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("CodeSail aktualisieren?",
            "Die App wird neu geladen. Lokale Änderungen sind gespeichert und bleiben erhalten.",
            yesText: "Neu laden", cancelText: "Später");
        if (confirmed != true)
            return;

        // Kurz warten, damit das automatische Speichern des Editors (500 ms) sicher durch ist
        await Task.Delay(600);
        await Browser.ApplyUpdateAsync();
    }

    private async Task LogoutAsync()
    {
        var dirty = await Workspace.CountDirtyFilesAsync();
        var message = dirty > 0
            ? $"{dirty} Datei(en) mit lokalen, noch nicht committeten Änderungen gehen dabei verloren."
            : "Token und Offline-Kopien werden von diesem Gerät gelöscht.";

        var confirmed = await Dialogs.ShowMessageBoxAsync("Abmelden?", message, yesText: "Abmelden", cancelText: "Abbrechen");
        if (confirmed != true)
            return;

        await Workspace.ClearCacheAsync();
        await Auth.LogoutAsync();
        // Bewusstes Abmelden: nach dem nächsten Anmelden bei der Repo-Liste beginnen
        Auth.ReturnUrl = null;
        Nav.NavigateTo("", replace: true);
    }

    private void OnStateChanged()
    {
        InvokeAsync(() =>
        {
            OnParametersSet();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Auth.Changed -= OnStateChanged;
        GitHub.RateLimitChanged -= OnStateChanged;
        Browser.ConnectivityChanged -= OnStateChanged;
        Browser.UpdateReady -= OnStateChanged;
        Settings.Changed -= OnStateChanged;
    }
}
