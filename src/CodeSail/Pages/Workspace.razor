@page "/repo/{Owner}/{Name}"
@inject IGitHubService GitHub
@inject NavigationManager Nav

<PageTitle>CodeSail – @Owner/@Name</PageTitle>

<div class="workspace">
    @if (_explorerOpen)
    {
        <aside class="explorer">
            <div class="d-flex align-center mb-2">
                <MudIconButton Href="repos" Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" aria-label="Zurück zu den Repositories" />
                <MudText Typo="Typo.subtitle1" Class="ml-1 text-truncate" title="@($"{Owner}/{Name}")">@Name</MudText>
            </div>

            @if (_branches is not null)
            {
                <MudSelect T="BranchInfo" Value="_branch" ValueChanged="OnBranchChanged" Label="Branch"
                           Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Class="mb-2"
                           ToStringFunc="@(b => b?.Name ?? "")" AdornmentIcon="@Icons.Material.Filled.AccountTree">
                    @foreach (var branch in _branches)
                    {
                        <MudSelectItem Value="branch">@branch.Name</MudSelectItem>
                    }
                </MudSelect>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">
                    @_error
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick="ReloadAsync">Erneut versuchen</MudButton>
                </MudAlert>
            }
            else if (_tree is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                @if (_tree.Truncated)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                        Das Repository ist sehr groß, GitHub hat nicht alle Dateien geliefert.
                    </MudAlert>
                }
                <FileExplorer Tree="_tree" FileSelected="path => _selectedPath = path" />
            }
        </aside>
    }

    <section class="editor-area">
        <div class="editor-toolbar">
            <MudIconButton Icon="@(_explorerOpen ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                           OnClick="() => _explorerOpen = !_explorerOpen" aria-label="Explorer umschalten" />
            <MudText Typo="Typo.body2" Class="text-truncate">@(_selectedPath ?? "Keine Datei geöffnet")</MudText>
        </div>
        <div class="editor-placeholder">
            <MudIcon Icon="@Icons.Material.Outlined.Code" Size="Size.Large" />
            <MudText Class="mud-text-secondary">
                @(_selectedPath is null ? "Wähle links eine Datei aus." : "Der Editor folgt in Phase 2.")
            </MudText>
        </div>
    </section>
</div>

@code {
    private IReadOnlyList<BranchInfo>? _branches;
    private BranchInfo? _branch;
    private RepoTree? _tree;
    private string? _selectedPath;
    private string? _error;
    private bool _explorerOpen = true;
    private string? _loadedRepo;

    [Parameter] public string Owner { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    [SupplyParameterFromQuery(Name = "branch")] public string? BranchName { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (_loadedRepo != $"{Owner}/{Name}")
                await LoadBranchesAsync();

            var wanted = _branches!.FirstOrDefault(b => b.Name == BranchName) ?? _branch;
            if (wanted is not null && wanted != _branch || _tree is null)
                await LoadTreeAsync(wanted ?? _branches![0]);
        }
        catch (Exception ex)
        {
            _error = GitHubErrors.Describe(ex);
        }
    }

    private async Task LoadBranchesAsync()
    {
        _error = null;
        _branches = null;
        _branch = null;
        _tree = null;
        _selectedPath = null;

        var repo = await GitHub.GetRepositoryAsync(Owner, Name);
        _branches = await GitHub.GetBranchesAsync(Owner, Name);
        if (_branches.Count == 0)
            throw new InvalidOperationException("Das Repository ist leer.");

        _branch = _branches.FirstOrDefault(b => b.Name == repo.DefaultBranch) ?? _branches[0];
        _loadedRepo = $"{Owner}/{Name}";
    }

    private async Task LoadTreeAsync(BranchInfo branch)
    {
        _error = null;
        _branch = branch;
        _tree = null;
        _selectedPath = null;
        StateHasChanged();

        _tree = await GitHub.GetTreeAsync(Owner, Name, branch.CommitSha);
    }

    private void OnBranchChanged(BranchInfo branch) =>
        // Branch in der URL halten, damit Neuladen und Lesezeichen funktionieren
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("branch", branch.Name), replace: true);

    private async Task ReloadAsync()
    {
        _loadedRepo = null;
        await OnParametersSetAsync();
    }
}
