@page "/repo/{Owner}/{Name}"
@implements IDisposable
@inject WorkspaceService RepoData
@inject CommitService Commits
@inject BrowserEnvironment Browser
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IJSRuntime JS

<PageTitle>CodeSail – @(ActiveFile?.Name ?? $"{Owner}/{Name}")</PageTitle>

<div class="workspace">
    @if (_explorerOpen)
    {
        <aside class="explorer">
            <div class="d-flex align-center mb-2">
                <MudIconButton Href="repos" Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" aria-label="Zurück zu den Repositories" />
                <MudText Typo="Typo.subtitle1" Class="ml-1 text-truncate" title="@($"{Owner}/{Name}")">@Name</MudText>
                @if (_fromCache)
                {
                    <MudTooltip Text="GitHub ist nicht erreichbar. Angezeigt wird der zuletzt geladene Stand.">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="ml-auto">Offline-Kopie</MudChip>
                    </MudTooltip>
                }
            </div>

            @if (_branches is { Count: > 0 })
            {
                <div class="d-flex align-center gap-1 mb-2">
                    <MudSelect T="BranchInfo" Value="_branch" ValueChanged="OnBranchChanged" Label="Branch"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true"
                               ToStringFunc="@(b => b?.Name ?? "")" AdornmentIcon="@Icons.Material.Filled.AccountTree">
                        @foreach (var branch in _branches)
                        {
                            <MudSelectItem Value="branch">@branch.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTooltip Text="Neuen Branch anlegen">
                        <MudIconButton Icon="@Icons.Material.Filled.AddCircleOutline" OnClick="CreateBranchAsync"
                                       Disabled="@(!Browser.IsOnline)" aria-label="Neuen Branch anlegen" />
                    </MudTooltip>
                    <MudTooltip Text="Neu von GitHub laden (offene Dateien bleiben offen, lokale Änderungen bleiben erhalten)">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="ReloadAsync"
                                       Disabled="@(_tree is null)" aria-label="Aktualisieren" />
                    </MudTooltip>
                </div>
            }

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">
                    @_error
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick="ReloadAsync">Erneut versuchen</MudButton>
                </MudAlert>
            }
            else if (_emptyRepo)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Das Repository ist noch leer. Lege eine erste Datei an, danach kannst du wie gewohnt arbeiten.
                </MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" StartIcon="@Icons.Material.Filled.NoteAdd"
                           OnClick="InitializeRepositoryAsync" Disabled="@(_committing || !Browser.IsOnline)">
                    README.md anlegen
                </MudButton>
            }
            else if (_displayTree is null)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else
            {
                <MudTabs Elevation="0" Rounded="false" KeepPanelsAlive="true" Centered="true" @bind-ActivePanelIndex="_sidePanel"
                         TabPanelsClass="pt-2" MinimumTabWidth="100px">
                    <MudTabPanel Text="Dateien" Icon="@Icons.Material.Outlined.Folder">
                        @if (_displayTree.Truncated)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                                Das Repository ist sehr groß, GitHub hat nicht alle Dateien geliefert.
                            </MudAlert>
                        }
                        <MudButton StartIcon="@Icons.Material.Filled.NoteAdd" Size="Size.Small" Variant="Variant.Text"
                                   OnClick="NewFileAsync" Class="mb-1">Neue Datei</MudButton>
                        <FileExplorer Tree="_displayTree" DirtyPaths="DirtyPaths" FileSelected="OpenFileAsync" />
                    </MudTabPanel>
                    <MudTabPanel Text="Änderungen" Icon="@Icons.Material.Outlined.Difference"
                                 BadgeData="@(_changes.Count > 0 ? _changes.Count : null)" BadgeColor="Color.Warning">
                        <ChangesPanel @ref="_changesPanel" Changes="_changes" Branch="@(_branch?.Name ?? "")"
                                      SelectedKey="_diffKey" Online="Browser.IsOnline" Busy="_committing"
                                      Selected="ShowDiff" Discard="DiscardAsync" Commit="CommitAsync" />
                    </MudTabPanel>
                </MudTabs>
            }
        </aside>
    }

    <section class="editor-area">
        <div class="editor-toolbar">
            <MudIconButton Icon="@(_explorerOpen ? Icons.Material.Filled.MenuOpen : Icons.Material.Filled.Menu)"
                           OnClick="() => _explorerOpen = !_explorerOpen" aria-label="Seitenleiste umschalten" />

            <div class="tabs" role="tablist">
                @if (DiffFile is { } diff)
                {
                    <div class="tab active" role="tab" title="@($"Änderungen: {diff.Path}")" aria-selected="true">
                        <MudIcon Icon="@Icons.Material.Outlined.Difference" Size="Size.Small" />
                        <span class="tab-name">@diff.Name</span>
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="tab-close"
                                       OnClick="() => _diffKey = null" aria-label="Vergleich schließen" />
                    </div>
                }
                @foreach (var file in _openFiles)
                {
                    var active = DiffFile is null && file.Key == _activeKey;
                    <div class="tab @(active ? "active" : "")" role="tab" title="@file.Path"
                         aria-selected="@active" @onclick="() => ActivateTab(file.Key)">
                        <span class="tab-name">@file.Name</span>
                        @if (file.IsDirty)
                        {
                            <span class="tab-dirty" title="Lokal geändert, noch nicht committet">●</span>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Class="tab-close"
                                       OnClick="() => CloseFileAsync(file)" aria-label="@($"{file.Name} schließen")" />
                    </div>
                }
            </div>

            @if (DiffFile is null && ActiveFile is { } current)
            {
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight" aria-label="Dateiaktionen">
                    <MudMenuItem Icon="@Icons.Material.Outlined.Difference" Disabled="!current.IsDirty"
                                 OnClick="() => ShowDiff(current)">Änderungen anzeigen</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.DriveFileRenameOutline" OnClick="RenameActiveAsync">Umbenennen / verschieben</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Undo" Disabled="!current.IsDirty"
                                 OnClick="() => DiscardAsync(current)">Änderungen verwerfen</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="DeleteActiveAsync">Datei löschen</MudMenuItem>
                </MudMenu>
            }
        </div>

        <div class="editor-host @(ActiveFile is null || DiffFile is not null ? "hidden" : "")">
            <SourceEditor @ref="_editor" File="ActiveFile" ContentChanged="OnContentChangedAsync" SaveRequested="OnSaveRequested" />
        </div>

        @if (DiffFile is not null)
        {
            <div class="editor-host">
                <DiffView File="DiffFile" />
            </div>
        }
        else if (ActiveFile is null)
        {
            <div class="editor-placeholder">
                <MudIcon Icon="@Icons.Material.Outlined.Code" Size="Size.Large" />
                <MudText Class="mud-text-secondary">Wähle links eine Datei aus.</MudText>
            </div>
        }
    </section>
</div>

@code {
    private IReadOnlyList<BranchInfo>? _branches;
    private BranchInfo? _branch;
    private RepoTree? _tree;
    private RepoTree? _displayTree;
    private string? _treeSignature;
    private bool _fromCache;
    private bool _emptyRepo;
    private string? _error;
    private bool _explorerOpen = true;
    private string? _loadedRepo;

    private readonly List<CachedFile> _openFiles = [];
    private string? _activeKey;
    private SourceEditor? _editor;

    private List<CachedFile> _changes = [];
    private string? _diffKey;
    private int _sidePanel;
    private bool _committing;
    private ChangesPanel? _changesPanel;

    [Parameter] public string Owner { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    [SupplyParameterFromQuery(Name = "branch")] public string? BranchName { get; set; }

    private CachedFile? ActiveFile => _openFiles.FirstOrDefault(f => f.Key == _activeKey);

    private CachedFile? DiffFile => _changes.FirstOrDefault(f => f.Key == _diffKey);

    private IReadOnlySet<string> DirtyPaths => _changes.Where(f => !f.Deleted).Select(f => f.Path).ToHashSet();

    protected override void OnInitialized() => Browser.ConnectivityChanged += OnConnectivityChanged;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            if (_loadedRepo != $"{Owner}/{Name}")
                await LoadBranchesAsync();
            if (_emptyRepo)
                return;

            var wanted = _branches!.FirstOrDefault(b => b.Name == BranchName) ?? _branch;
            if (wanted is not null && wanted != _branch || _tree is null)
                await LoadTreeAsync(wanted ?? _branches![0]);
        }
        catch (Exception ex)
        {
            _error = GitHubErrors.Describe(ex);
        }
    }

    private async Task LoadBranchesAsync()
    {
        _error = null;
        _branches = null;
        _branch = null;
        _tree = null;

        var loaded = await RepoData.LoadBranchesAsync(Owner, Name);
        _fromCache = loaded.FromCache;
        _branches = loaded.Value.Branches;
        _loadedRepo = $"{Owner}/{Name}";
        _emptyRepo = _branches.Count == 0;
        if (_emptyRepo)
            return;

        _branch = _branches.FirstOrDefault(b => b.Name == BranchName)
            ?? _branches.FirstOrDefault(b => b.Name == loaded.Value.DefaultBranch)
            ?? _branches[0];
    }

    private async Task InitializeRepositoryAsync()
    {
        _committing = true;
        try
        {
            await RepoData.InitializeRepositoryAsync(Owner, Name);
            Snackbar.Add("README.md angelegt.", Severity.Success);
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(GitHubErrors.Describe(ex), Severity.Error);
        }
        finally
        {
            _committing = false;
        }
    }

    /// <summary>Lädt den Baum eines Branches. Offene Tabs bleiben offen, sofern es die Dateien dort gibt.</summary>
    private async Task LoadTreeAsync(BranchInfo branch)
    {
        var reopen = _openFiles.Select(f => f.Path).ToList();
        var activePath = ActiveFile?.Path;

        _error = null;
        _branch = branch;
        _tree = null;
        _displayTree = null;
        _diffKey = null;
        await CloseAllFilesAsync();
        StateHasChanged();

        var loaded = await RepoData.LoadTreeAsync(Owner, Name, branch);
        _tree = loaded.Value;
        _fromCache |= loaded.FromCache;
        await RefreshChangesAsync();

        // Lokal geänderte Dateien wieder öffnen, damit nach einem Neustart nichts übersehen wird
        foreach (var file in await RepoData.GetDirtyFilesAsync(Owner, Name, branch.Name))
            _openFiles.Add(file);

        foreach (var path in reopen.Where(p => _openFiles.All(f => f.Path != p) && _displayTree!.FilePaths.Contains(p)))
        {
            try
            {
                _openFiles.Add(await RepoData.OpenFileAsync(Owner, Name, branch.Name, path, _tree.BlobShas.GetValueOrDefault(path)));
            }
            catch (Exception)
            {
                // Nicht mehr ladbare Dateien werden einfach nicht wieder geöffnet
            }
        }

        _activeKey = (_openFiles.FirstOrDefault(f => f.Path == activePath) ?? _openFiles.LastOrDefault())?.Key;
    }

    /// <summary>Liest die lokalen Änderungen neu und aktualisiert den angezeigten Baum, falls Dateien hinzukamen oder fehlen.</summary>
    private async Task RefreshChangesAsync()
    {
        if (_branch is null || _tree is null)
            return;

        _changes = (await RepoData.GetChangesAsync(Owner, Name, _branch.Name)).ToList();
        if (_diffKey is not null && DiffFile is null)
            _diffKey = null;

        var signature = string.Join('|', _changes.Where(f => f.IsNew || f.Deleted).Select(f => $"{f.Change}:{f.Path}"));
        if (_displayTree is null || signature != _treeSignature)
        {
            _displayTree = WorkspaceService.ApplyLocalChanges(_tree, _changes);
            _treeSignature = signature;
        }
    }

    private async Task OpenFileAsync(string path)
    {
        if (_branch is null || _tree is null)
            return;

        var open = _openFiles.FirstOrDefault(f => f.Path == path);
        if (open is null)
        {
            try
            {
                open = await RepoData.OpenFileAsync(Owner, Name, _branch.Name, path, _tree.BlobShas.GetValueOrDefault(path));
                _openFiles.Add(open);
            }
            catch (Exception ex)
            {
                Snackbar.Add(GitHubErrors.Describe(ex), Severity.Error);
                return;
            }
        }

        ActivateTab(open.Key);
        if (await Browser.IsNarrowAsync())
            _explorerOpen = false;
    }

    private void ActivateTab(string key)
    {
        _activeKey = key;
        _diffKey = null;
    }

    private async Task OnContentChangedAsync((string Key, string Content) change)
    {
        var index = _openFiles.FindIndex(f => f.Key == change.Key);
        if (index < 0)
            return;

        try
        {
            var wasDirty = _openFiles[index].IsDirty;
            _openFiles[index] = await RepoData.SaveContentAsync(_openFiles[index], change.Content);

            var changeIndex = _changes.FindIndex(f => f.Key == change.Key);
            if (changeIndex >= 0)
                _changes[changeIndex] = _openFiles[index];
            if (wasDirty != _openFiles[index].IsDirty)
                await RefreshChangesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Lokales Speichern fehlgeschlagen: {ex.Message}", Severity.Error);
        }
    }

    private void OnSaveRequested() =>
        Snackbar.Add("Lokal gespeichert", Severity.Success, o => o.VisibleStateDuration = 1500);

    private async Task CloseFileAsync(CachedFile file)
    {
        // Änderungen bleiben im Cache erhalten; der Tab öffnet sich beim nächsten Laden wieder
        if (_editor is not null)
            await _editor.CloseFileAsync(file.Key);

        var index = _openFiles.FindIndex(f => f.Key == file.Key);
        if (index < 0)
            return;
        _openFiles.RemoveAt(index);
        if (_activeKey == file.Key)
            _activeKey = _openFiles.Count == 0 ? null : _openFiles[Math.Min(index, _openFiles.Count - 1)].Key;
    }

    private async Task CloseAllFilesAsync()
    {
        foreach (var file in _openFiles.ToList())
            await CloseFileAsync(file);
    }

    private async Task ShowDiff(CachedFile file)
    {
        if (_editor is not null)
            await _editor.FlushAsync();
        await RefreshChangesAsync();
        _diffKey = file.Key;
        if (await Browser.IsNarrowAsync())
            _explorerOpen = false;
    }

    private async Task DiscardAsync(CachedFile file)
    {
        var what = file.Change switch
        {
            ChangeKind.Added => $"Die neue Datei {file.Name} wird entfernt.",
            ChangeKind.Deleted => $"{file.Name} wird wiederhergestellt.",
            _ => $"Alle lokalen Änderungen an {file.Name} gehen verloren."
        };
        var confirmed = await Dialogs.ShowMessageBoxAsync("Änderungen verwerfen?", what, yesText: "Verwerfen", cancelText: "Abbrechen");
        if (confirmed != true)
            return;

        if (_editor is not null)
            await _editor.FlushAsync();

        var current = await RepoData.DiscardChangesAsync(_openFiles.FirstOrDefault(f => f.Key == file.Key) ?? file);
        var index = _openFiles.FindIndex(f => f.Key == file.Key);
        if (current is null)
        {
            if (index >= 0)
                await CloseFileAsync(_openFiles[index]);
        }
        else if (index >= 0)
        {
            _openFiles[index] = current;
            if (_editor is not null)
                await _editor.SetContentAsync(file.Key, current.Content);
        }

        await RefreshChangesAsync();
    }

    private async Task NewFileAsync()
    {
        if (_branch is null || _displayTree is null)
            return;

        var folder = ActiveFile?.Path is { } p && p.Contains('/') ? p[..(p.LastIndexOf('/') + 1)] : "";
        var path = await TextPromptDialog.ShowAsync(Dialogs, "Neue Datei", "Pfad im Repository", folder, "Anlegen",
            "Ordner werden mit / angegeben, z. B. docs/anleitung.md. Fehlende Ordner entstehen automatisch.");
        if (path is null)
            return;

        try
        {
            var file = await RepoData.CreateFileAsync(Owner, Name, _branch.Name, path, _displayTree);
            _openFiles.Add(file);
            ActivateTab(file.Key);
            await RefreshChangesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(GitHubErrors.Describe(ex), Severity.Error);
        }
    }

    private async Task RenameActiveAsync()
    {
        if (ActiveFile is not { } file || _displayTree is null)
            return;

        var path = await TextPromptDialog.ShowAsync(Dialogs, "Umbenennen / verschieben", "Neuer Pfad", file.Path, "Umbenennen");
        if (path is null || path == file.Path)
            return;

        try
        {
            if (_editor is not null)
                await _editor.FlushAsync();
            var current = _openFiles.First(f => f.Key == file.Key);
            var renamed = await RepoData.RenameFileAsync(current, path, _displayTree);
            await CloseFileAsync(current);
            _openFiles.Add(renamed);
            ActivateTab(renamed.Key);
            await RefreshChangesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(GitHubErrors.Describe(ex), Severity.Error);
        }
    }

    private async Task DeleteActiveAsync()
    {
        if (ActiveFile is not { } file)
            return;

        var message = file.IsNew
            ? $"Die neue Datei {file.Name} wurde noch nie committet und wird sofort entfernt."
            : $"{file.Name} wird beim nächsten Commit auf GitHub gelöscht. Bis dahin kannst du das unter \"Änderungen\" rückgängig machen.";
        var confirmed = await Dialogs.ShowMessageBoxAsync("Datei löschen?", message, yesText: "Löschen", cancelText: "Abbrechen");
        if (confirmed != true)
            return;

        if (_editor is not null)
            await _editor.FlushAsync();
        await RepoData.DeleteFileAsync(_openFiles.First(f => f.Key == file.Key));
        await CloseFileAsync(file);
        await RefreshChangesAsync();
    }

    private async Task CommitAsync(ChangesPanel.CommitOptions options)
    {
        if (_branch is null || _branches is null)
            return;

        _committing = true;
        try
        {
            if (_editor is not null)
                await _editor.FlushAsync();
            await RefreshChangesAsync();

            if (options.NewBranch is not null)
                WorkspaceService.ValidateBranchName(options.NewBranch, _branches);

            var request = new CommitRequest(Owner, Name, _branch.Name, options.Message, _changes,
                options.NewBranch, options.CreatePullRequest);
            var result = await Commits.CommitAsync(request);

            if (!result.Succeeded && await ConfirmOverwriteAsync(result.Conflicts))
                result = await Commits.CommitAsync(request with { OverwriteConflicts = true });
            if (!result.Succeeded)
                return;

            _changesPanel?.Reset();
            ReportSuccess(result);
            await ReloadAfterCommitAsync(result.TargetBranch);
        }
        catch (Exception ex)
        {
            Snackbar.Add(GitHubErrors.Describe(ex), Severity.Error);
        }
        finally
        {
            _committing = false;
        }
    }

    private async Task<bool> ConfirmOverwriteAsync(IReadOnlyList<string> conflicts)
    {
        var files = string.Join("", conflicts.Select(c => $"<li><code>{System.Net.WebUtility.HtmlEncode(c)}</code></li>"));
        var message = new MarkupString(
            "<p>Diese Dateien wurden auf GitHub geändert, seit du sie geöffnet hast:</p>" +
            $"<ul style=\"margin: 8px 0 8px 20px\">{files}</ul>" +
            "<p>Wenn du trotzdem committest, ersetzt deine Fassung die Änderungen auf GitHub. " +
            "Alternativ verwirfst du deine Änderung an der Datei, lädst damit den neuen Stand und überträgst deine Anpassung erneut.</p>");

        return await Dialogs.ShowMessageBoxAsync("Konflikt", message,
            yesText: "Meine Fassung committen", cancelText: "Abbrechen") == true;
    }

    private void ReportSuccess(CommitResult result)
    {
        var shortSha = result.CommitSha![..7];
        if (result.PullRequestUrl is { } url)
        {
            Snackbar.Add($"Commit {shortSha} auf {result.TargetBranch} gepusht und Pull Request erstellt.", Severity.Success, o =>
            {
                o.RequireInteraction = true;
                o.Action = "Öffnen";
                o.OnClick = _ => JS.InvokeVoidAsync("open", url, "_blank").AsTask();
            });
        }
        else
        {
            Snackbar.Add($"Commit {shortSha} auf {result.TargetBranch} gepusht.", Severity.Success);
        }
    }

    private async Task ReloadAfterCommitAsync(string targetBranch)
    {
        _loadedRepo = null;
        _tree = null;
        if (targetBranch != _branch?.Name)
        {
            // Neuer Branch: die URL-Änderung lädt Branches und Baum neu
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("branch", targetBranch), replace: true);
            return;
        }
        await OnParametersSetAsync();
    }

    private async Task CreateBranchAsync()
    {
        if (_branch is null || _branches is null)
            return;

        var name = await TextPromptDialog.ShowAsync(Dialogs, "Neuer Branch", "Name", "", "Anlegen",
            $"Der Branch startet beim aktuellen Stand von {_branch.Name} auf GitHub. " +
            "Lokale Änderungen bleiben auf dem bisherigen Branch; um sie in einen neuen Branch zu committen, " +
            "nutze unter \"Änderungen\" die Option \"In neuen Branch committen\".");
        if (name is null)
            return;

        try
        {
            var created = await RepoData.CreateBranchAsync(Owner, Name, _branch.Name, name, _branches);
            Snackbar.Add($"Branch {created.Name} angelegt.", Severity.Success);
            _loadedRepo = null;
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("branch", created.Name), replace: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(GitHubErrors.Describe(ex), Severity.Error);
        }
    }

    private void OnBranchChanged(BranchInfo branch) =>
        // Branch in der URL halten, damit Neuladen und Lesezeichen funktionieren
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("branch", branch.Name), replace: true);

    private async Task ReloadAsync()
    {
        _loadedRepo = null;
        await OnParametersSetAsync();
    }

    private void OnConnectivityChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Browser.ConnectivityChanged -= OnConnectivityChanged;
}
