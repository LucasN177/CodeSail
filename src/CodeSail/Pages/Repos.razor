@page "/repos"
@inject WorkspaceService RepoData
@inject NavigationManager Nav

<PageTitle>CodeSail – Repositories</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-6 mb-6">
    <div class="d-flex align-center mb-3">
        <MudText Typo="Typo.h5">Repositories</MudText>
        @if (_fromCache)
        {
            <MudTooltip Text="GitHub ist nicht erreichbar. Angezeigt wird die zuletzt geladene Liste.">
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Class="ml-2">Offline-Kopie</MudChip>
            </MudTooltip>
        }
        <MudSpacer />
        <MudTooltip Text="Liste neu von GitHub laden">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync" Disabled="@(_repos is null && _error is null)"
                           aria-label="Repositories aktualisieren" />
        </MudTooltip>
    </div>

    <MudTextField @bind-Value="_filter" Placeholder="Repository suchen…" Variant="Variant.Outlined"
                  Immediate="true" Clearable="true" Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search" Class="mb-3"
                  spellcheck="false" autocapitalize="off" />

    @if (_repos is null && _error is null)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
    }
    else if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">
            @_error
            <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LoadAsync" Class="ml-2">Erneut versuchen</MudButton>
        </MudAlert>
    }
    else if (!FilteredRepos.Any())
    {
        <MudText Class="mud-text-secondary">Keine Repositories gefunden.</MudText>
    }
    else
    {
        <MudPaper Elevation="1">
            <MudList T="RepoSummary">
                @foreach (var repo in FilteredRepos)
                {
                    <MudListItem T="RepoSummary" Value="repo" OnClick="() => Open(repo)"
                                 Icon="@(repo.IsPrivate ? Icons.Material.Filled.Lock : Icons.Material.Filled.Book)">
                        <MudText Typo="Typo.body1">@repo.FullName</MudText>
                        @if (!string.IsNullOrWhiteSpace(repo.Description))
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">@repo.Description</MudText>
                        }
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    }
</MudContainer>

@code {
    private IReadOnlyList<RepoSummary>? _repos;
    private string? _filter;
    private string? _error;
    private bool _fromCache;

    private IEnumerable<RepoSummary> FilteredRepos =>
        string.IsNullOrWhiteSpace(_filter)
            ? _repos ?? []
            : (_repos ?? []).Where(r => r.FullName.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase));

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        _repos = null;
        try
        {
            var loaded = await RepoData.LoadRepositoriesAsync();
            _repos = loaded.Value;
            _fromCache = loaded.FromCache;
        }
        catch (Exception ex)
        {
            _error = GitHubErrors.Describe(ex);
        }
    }

    private void Open(RepoSummary repo) =>
        Nav.NavigateTo($"repo/{Uri.EscapeDataString(repo.Owner)}/{Uri.EscapeDataString(repo.Name)}");
}
